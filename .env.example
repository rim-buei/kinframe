# Public URL used for OIDC redirect URIs and absolute links (no secrets).
PUBLIC_BASE_URL=http://localhost:8080

# Required for encrypted session cookies (use a long random string in real deployments).
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Upload limit (bytes). Default 100MiB.
MAX_UPLOAD_BYTES=104857600

# Object storage backend for originals + thumb/preview derivatives.
#   fs   — local filesystem (default when S3_BUCKET is empty); good for DEV_FAKE_OIDC smoke
#   stub — no-op (uploads fail)
#   s3   — not implemented yet (set S3_* later / use MinIO-compatible endpoint then)
STORAGE_BACKEND=fs
STORAGE_PATH=./data/objects

# S3 (leave empty for local fs backend)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GLACIER_STORAGE_CLASS=GLACIER

# OIDC — each self-host operator supplies their own client credentials.
# Redirect URIs to register with the IdP:
#   {PUBLIC_BASE_URL}/auth/callback/google
#   {PUBLIC_BASE_URL}/auth/callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Either set a pre-built Apple client_secret JWT, or the key material below.
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents; use \n for newlines when placing on a single env line.
APPLE_PRIVATE_KEY=

# Local-only fake IdP for smoke tests without Google/Apple (never enable in production).
DEV_FAKE_OIDC=0
