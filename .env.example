# Public URL used for OIDC redirect URIs and absolute links (no secrets).
PUBLIC_BASE_URL=http://localhost:8080

# Upload limit (bytes). Default 100MiB.
MAX_UPLOAD_BYTES=104857600

# S3 (optional for scaffold; leave empty to run with stub storage)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GLACIER_STORAGE_CLASS=GLACIER

# OIDC — each self-host operator supplies their own client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
